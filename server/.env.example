# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# JWT secret — MUST be replaced with a strong, unique value before production
JWT_SECRET=change_me_to_a_long_random_secret

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# How often the recurring scheduler runs (milliseconds). Default: 1 hour.
RECURRING_SCHEDULE_MS=3600000